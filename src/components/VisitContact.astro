---
import Flag from './Flag.astro';
import CallbackForm from './CallbackForm.astro';
import { practice } from '../data/content';
---

<!-- Opaque background is required, not cosmetic: this panel slides over the
     pinned Organisations section, and a transparent one would let it show
     through. Rounded top edge and shadow match the founder panel. -->
<section
  id="contact"
  class="section relative scroll-mt-20 bg-paper lg:rounded-t-[0.875rem] lg:shadow-[0_-28px_64px_-24px_rgba(19,36,31,0.18)]"
>
  <div class="shell">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14">
      <!-- Details -->
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal="fade">Visit &amp; enquire</p>
        <h2 class="block-mask mt-5 text-ink" style="font-size: var(--text-h1)">
          <span>Model Town, Rohtak.</span>
        </h2>

        <dl class="mt-9 divide-y divide-line border-y border-line" data-stagger>
          <div class="flex gap-6 py-4">
            <dt class="w-20 flex-none text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-ink-faint">
              Clinic
            </dt>
            <dd class="text-ink">
              <Flag note={practice.addressVerify}>
                <span class="not-italic">
                  {practice.addressLines.map((l, i) => (
                    <>{l}{i < practice.addressLines.length - 1 ? <br /> : null}</>
                  ))}
                </span>
              </Flag>
            </dd>
          </div>

          <div class="flex gap-6 py-4">
            <dt class="w-20 flex-none text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-ink-faint">
              Phone
            </dt>
            <dd>
              <a href={practice.phoneHref} class="text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-clay">
                {practice.phoneDisplay}
              </a>
              <span class="mt-1 block text-[0.75rem] text-ink-faint">
                <Flag note={practice.missing.whatsapp} label="confirm">WhatsApp availability unconfirmed</Flag>
              </span>
            </dd>
          </div>

          <div class="flex gap-6 py-4">
            <dt class="w-20 flex-none text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-ink-faint">
              Email
            </dt>
            <dd>
              <a href={`mailto:${practice.email}`} class="break-all text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-clay">
                {practice.email}
              </a>
            </dd>
          </div>

          <!-- Hours are genuinely unknown. Designing the slot and saying so is
               more honest, and more useful, than inventing plausible timings. -->
          <div class="flex gap-6 py-4">
            <dt class="w-20 flex-none text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-ink-faint">
              Hours
            </dt>
            <dd class="text-ink-faint">
              <span class="italic">Awaiting the clinic's consulting days and times</span>
              <span class="mt-1 block text-[0.75rem]">
                Not published anywhere on the existing site (Q15)
              </span>
            </dd>
          </div>
        </dl>

        <!-- Map placeholder, designed rather than empty. -->
        <div class="relative mt-8 overflow-hidden rounded-md border border-line bg-paper-sunk" style="aspect-ratio: 16 / 9">
          <svg class="absolute inset-0 h-full w-full" aria-hidden="true">
            <defs>
              <pattern id="mapgrid" width="34" height="34" patternUnits="userSpaceOnUse">
                <path d="M34 0H0v34" fill="none" stroke="var(--color-line)" stroke-width="1" />
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#mapgrid)" />
          </svg>
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 px-6 text-center">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M10 18s6-5.2 6-9.4A6 6 0 0 0 4 8.6C4 12.8 10 18 10 18Z"
                stroke="var(--color-clay)"
                stroke-width="1.4"
                stroke-linejoin="round"></path>
              <circle cx="10" cy="8.5" r="2" stroke="var(--color-clay)" stroke-width="1.4"></circle>
            </svg>
            <p class="text-[0.8125rem] font-medium text-ink">Map &amp; directions</p>
            <p class="max-w-[34ch] text-[0.75rem] leading-relaxed text-ink-faint">
              {practice.missing.map}. A pin, written directions and a photo of the
              building entrance go here once confirmed.
            </p>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="lg:col-span-6 lg:col-start-7">
        <CallbackForm />
      </div>
    </div>
  </div>
</section>
