---
import Logo from './Logo.astro';
import { nav, practice } from '../data/content';
---

<header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur-md">
  {/* Reading progress. Pure CSS scroll timeline where supported, invisible
      elsewhere — it is a nicety, never a control. */}
  <div
    class="progress-bar absolute inset-x-0 bottom-[-1px] h-[2px] bg-clay"
    aria-hidden="true"
  >
  </div>

  <div class="shell flex h-16 items-center justify-between gap-6 md:h-[4.5rem]">
    <Logo />

    <!-- Desktop navigation -->
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link relative py-2 text-[0.8125rem] font-medium tracking-wide text-ink-soft transition-colors hover:text-ink"
              >
                {item.label}
                {item.provisional && (
                  <span
                    class="absolute -right-2 top-1 size-1 rounded-full bg-clay/60"
                    title="Provisional — pending client confirmation that workshops are still offered"
                    aria-hidden="true"
                  />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-4">
      <a
        href={practice.phoneHref}
        class="hidden text-[0.8125rem] font-medium text-ink-soft transition-colors hover:text-ink xl:block"
      >
        {practice.phoneDisplay}
      </a>
      <a href="#contact" class="btn btn-primary magnetic hidden !min-h-[2.625rem] !px-5 sm:inline-flex">
        Request a call back
      </a>

      <!-- Mobile trigger -->
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="-mr-2 flex size-11 items-center justify-center rounded-md text-ink lg:hidden"
      >
        <span class="sr-only">Open menu</span>
        <svg width="22" height="14" viewBox="0 0 22 14" aria-hidden="true">
          <path d="M0 1h22M0 7h22M0 13h14" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  hidden
  class="fixed inset-0 z-50 flex flex-col bg-paper lg:hidden"
>
  <div class="shell flex h-16 flex-none items-center justify-between border-b border-line">
    <Logo />
    <button
      type="button"
      onclick="document.getElementById('menu-toggle').click()"
      class="-mr-2 flex size-11 items-center justify-center rounded-md text-ink"
    >
      <span class="sr-only">Close menu</span>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
        <path d="M1 1l16 16M17 1L1 17" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  <nav aria-label="Mobile" class="shell flex-1 overflow-y-auto py-6">
    <ul class="divide-y divide-line">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="flex min-h-[3.5rem] items-center justify-between font-serif text-2xl text-ink"
            >
              {item.label}
              {item.provisional && (
                <span class="text-[0.625rem] font-semibold uppercase tracking-[0.1em] text-clay">
                  provisional
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="shell flex-none space-y-3 border-t border-line py-5 pb-[max(1.25rem,env(safe-area-inset-bottom))]">
    <a href="#contact" class="btn btn-primary w-full">Request a call back</a>
    <a href={practice.phoneHref} class="btn btn-ghost w-full">
      Call {practice.phoneDisplay}
    </a>
  </div>
</div>
