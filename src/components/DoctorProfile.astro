---
import { Image } from 'astro:assets';
import Flag from './Flag.astro';
import { doctor } from '../data/content';
import portrait from '../assets/dr-rajeev-sharma.png';
---

<!-- One of only two deep-colour sections on the page. Used here because the
     doctor IS the product for a single-practitioner practice, and colour is
     the strongest emphasis available. -->
<!-- The rounded top edge and the upward shadow are what make this read as a
     panel arriving over the section behind it, rather than just the next block. -->
<section
  class="on-dark relative overflow-hidden bg-teal-900 text-white lg:rounded-t-[0.875rem] lg:shadow-[0_-28px_64px_-24px_rgba(19,36,31,0.45)]"
>
  {/* The practice's own mark, enormous and almost invisible, as a ground tone
      for the darkest block on the page. */}
  <div
    class="pointer-events-none absolute -right-20 -top-24 hidden select-none lg:block"
    aria-hidden="true"
  >
    <span class="ghost-type block text-[22rem] text-white/[0.025]">S</span>
  </div>

  <div class="shell relative">
    <div class="grid grid-cols-1 gap-10 pb-16 pt-12 lg:grid-cols-12 lg:gap-14 lg:pb-24 lg:pt-14">
      <!-- The left column is a poster: portrait, the pull-quote, and a standing
           CTA. It sticks while the credentials on the right scroll past it.

           It carries the quote because a portrait alone left ~790px of empty
           teal beneath it on a tall screen. The portrait now fills the column
           (~440px) rather than sitting at 309px — the source is 300x450 so it
           is being scaled up and will look soft until a better photograph
           exists (Q13), which the caption says plainly. -->
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          <figure
            class="lift-dark relative mx-auto w-full max-w-[22rem] overflow-hidden rounded-sm lg:mx-0 lg:max-w-none"
            style="aspect-ratio: 4 / 5"
            data-reveal="scale"
          >
            <Image
              src={portrait}
              alt="Dr. Rajeev Sharma, founder of Swayam Heartcare and Wellness"
              widths={[300, 600]}
              sizes="(min-width: 1024px) 44vw, 22rem"
              class="h-full w-full object-cover object-top"
            />
            <div
              class="pointer-events-none absolute inset-2 sm:inset-3"
              style="border: 1px solid rgba(255,255,255,.16)"
              aria-hidden="true"
            >
            </div>
          </figure>

          <p
            class="mx-auto mt-3 max-w-[22rem] text-[0.75rem] leading-relaxed text-teal-300 lg:mx-0 lg:max-w-none"
            data-reveal="fade"
          >
            <Flag note="Existing portrait is 300×450px and is being scaled up here — a higher-resolution photograph is recommended before launch (Q13)">
              Existing photograph from the current website.
            </Flag>
          </p>

          <!-- Desktop only. Stacked on mobile this would put an unattributed
               quote above the name it belongs to, so the mobile copy of it
               sits further down, after the introduction. -->
          <blockquote
            class="mt-7 hidden border-l-2 border-clay pl-5 lg:block"
            data-reveal
            style="--d: 1"
          >
            <p class="font-serif text-xl leading-snug text-white">
              <Flag note={doctor.pullQuoteNote}>“{doctor.pullQuote}”</Flag>
            </p>
          </blockquote>

          <a href="#contact" class="btn btn-ghost mt-7 hidden lg:inline-flex">
            Request a consultation
            <svg class="arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M9 1l4 4-4 4M13 5H1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <p class="eyebrow" data-reveal="fade">Meet the founder</p>

        <h2 class="block-mask mt-5 text-white" style="font-size: var(--text-h1)">
          <span>{doctor.name}</span>
        </h2>
        <p class="mt-3 text-[0.9375rem] text-teal-300" data-reveal style="--d: 1">
          {doctor.role} ·{' '}
          <Flag note={doctor.disciplineVerify}>{doctor.discipline}</Flag>
        </p>

        <!-- On desktop the pull-quote sits beside the portrait and this column
             is the facts alone, which is what makes both of them land. On
             mobile it reappears here, below the name. -->
        <blockquote class="mt-7 border-l-2 border-clay pl-5 lg:hidden" data-reveal style="--d: 2">
          <p class="font-serif text-xl leading-snug text-white">
            <Flag note={doctor.pullQuoteNote}>“{doctor.pullQuote}”</Flag>
          </p>
        </blockquote>

        <div class="measure mt-8 space-y-4 text-teal-300" data-stagger>
          {doctor.bio.map((para, i) => (
            <p>{i === 0 ? <Flag note={doctor.bioNote}>{para}</Flag> : para}</p>
          ))}
        </div>

        <!-- Qualifications: scannable list, not prose. -->
        <h3 class="mt-10 text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-teal-300" style="font-family: var(--font-sans)">
          Qualifications
        </h3>
        <ul class="mt-4 space-y-2.5" data-stagger>
          {
            doctor.qualifications.map((q) => (
              <li class="flex gap-3 text-[0.9375rem] leading-snug">
                <span class="mt-[0.45rem] size-1 flex-none rounded-full bg-clay" aria-hidden="true" />
                <span><Flag note={q.note}>{q.text}</Flag></span>
              </li>
            ))
          }
        </ul>

        <!-- Career: a plain rule-separated list. The old site had this as an
             unreadable semicolon run-on. -->
        <h3 class="mt-9 text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-teal-300" style="font-family: var(--font-sans)">
          Experience · <Flag note={doctor.experienceNote}>20+ years</Flag>
        </h3>
        <ul class="mt-3 divide-y" style="border-color: var(--color-line-dark)" data-stagger>
          {
            doctor.career.map((c) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5 py-2.5 text-[0.9375rem]" style="border-color: var(--color-line-dark)">
                <span class={c.current ? 'text-white' : 'text-teal-300'}>
                  {c.note ? <Flag note={c.note}>{c.place}</Flag> : c.place}
                </span>
                <span class="text-[0.8125rem] text-teal-300">
                  {c.where}{c.current ? ' · current' : ''}
                </span>
              </li>
            ))
          }
        </ul>

        <a href="#contact" class="btn btn-ghost mt-9 lg:hidden">Request a consultation</a>
      </div>
    </div>
  </div>
</section>
