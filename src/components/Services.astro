---
import Flag from './Flag.astro';
import { services, servicesNote, benefitFrom } from '../data/content';

/**
 * The seven published services as one continuous numbered list.
 *
 * Deliberately not a card grid and not a sticky deck: the numbers run down a
 * single spine, and a clay line fills that spine as the list is scrolled past,
 * so the seven read as one sequence you are working through.
 */
---

<section id="services" class="section border-b border-line scroll-mt-20">
  <div class="shell">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal="fade">What we do</p>
        <h2 class="block-mask mt-5 text-ink" style="font-size: var(--text-h1)">
          <span>Seven strands, one programme.</span>
        </h2>
      </div>
      <div class="lg:col-span-5 lg:col-start-8 lg:pt-12">
        <p class="measure text-ink-soft">
          Each can be taken on its own, or together as the full programme.{' '}
          <Flag note={servicesNote} label="confirm">Session length and format vary.</Flag>
        </p>
      </div>
    </div>

    <div class="relative mt-12 sm:mt-16">
      {/* The spine: a faint full-height rule with a clay line that fills as the
          list is scrolled past. */}
      <div
        class="pointer-events-none absolute bottom-0 top-0 hidden w-px bg-line sm:block"
        style="left: calc(8.333% - 0.5rem)"
        aria-hidden="true"
      >
        <div class="svc-spine h-full w-px bg-clay"></div>
      </div>

      <ol class="border-t border-line">
        {
          services.map((s) => (
            <li class="svc-row border-b border-line">
              <div
                class="grid grid-cols-1 gap-x-8 gap-y-2 py-7 sm:grid-cols-12 sm:py-8"
                data-reveal
              >
                <div class="sm:col-span-1">
                  <span class="svc-num font-serif text-[0.9375rem] tracking-[0.1em] text-clay">
                    {s.n}
                  </span>
                </div>
                <h3 class="sm:col-span-5 text-ink" style="font-size: var(--text-h3)">
                  {s.name}
                </h3>
                <p class="sm:col-span-6 text-ink-soft">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- Self-qualification list. Useful content the old site buried at the
         bottom of an inner page. -->
    <div class="mt-14 grid grid-cols-1 gap-8 rounded-md bg-paper-sunk p-7 sm:p-9 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <h3 class="text-ink" style="font-size: var(--text-h3)" data-reveal>
          This is likely for you if…
        </h3>
      </div>
      <ul class="lg:col-span-8 grid grid-cols-1 gap-x-10 gap-y-0 sm:grid-cols-2" data-stagger>
        {
          benefitFrom.map((b) => (
            <li class="flex items-start gap-3 border-b border-line py-3 text-[0.9375rem] text-ink-soft last:border-b-0 sm:[&:nth-last-child(2)]:border-b-0">
              <span class="mt-[0.5rem] size-1 flex-none rounded-full bg-teal-600" aria-hidden="true" />
              {b}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
